<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Clash.Server</RootNamespace>
    <AssemblyName>Clash.Server</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clash.Core\Clash.Core.csproj" />
  </ItemGroup>

  <!-- The Vue production build is copied here by the frontend build. -->
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    TUN mode loads wintun.dll at run time, so it has to sit next to the
    executable. The licence requires the vendor's notice to travel with it, and
    third_party/wintun/README.md records where the binary came from.

    Included only when the output is for Windows: a `win-*` runtime identifier
    when one was requested, otherwise the build host. Testing the host alone is
    not enough — `dotnet publish -r linux-x64` from Windows is a normal way to
    produce the container's payload, and the DLL must not be dragged into it.
    The container build runs on Linux and excludes third_party from its context,
    so an unconditional copy fails that publish outright.
  -->
  <PropertyGroup>
    <IncludeWintun Condition="'$(RuntimeIdentifier)' != ''"
                   >$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))</IncludeWintun>
    <IncludeWintun Condition="'$(RuntimeIdentifier)' == ''"
                   >$([MSBuild]::IsOSPlatform('Windows'))</IncludeWintun>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeWintun)' == 'true'">
    <None Include="..\..\third_party\wintun\amd64\wintun.dll"
          Link="wintun.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
    <None Include="..\..\third_party\wintun\LICENSE.txt"
          Link="wintun-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
