<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Clash.Desktop</RootNamespace>
    <AssemblyName>Clash.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clash.Server\Clash.Server.csproj" />
  </ItemGroup>

  <!--
    The dashboard is published into Clash.Server/wwwroot and served by the
    embedded host. Content items do not flow across project references by
    default, so the tray build would ship without the dashboard unless the
    files are carried over explicitly.
  -->
  <ItemGroup>
    <Content Include="..\Clash.Server\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>

</Project>
