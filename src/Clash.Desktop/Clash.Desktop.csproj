<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Clash.Desktop</RootNamespace>
    <AssemblyName>Clash.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clash.Server\Clash.Server.csproj" />
  </ItemGroup>

  <!--
    The dashboard is published into Clash.Server/wwwroot and served by the
    embedded host. Content items do not flow across project references by
    default, so the tray build would ship without the dashboard unless the
    files are carried over explicitly.
  -->
  <ItemGroup>
    <Content Include="..\Clash.Server\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>

  <!--
    Same reasoning as the server: the tray is the build a user actually launches,
    so wintun.dll and the vendor notice it must travel with belong beside it.
  -->
  <ItemGroup>
    <None Include="..\..\third_party\wintun\amd64\wintun.dll"
          Link="wintun.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
    <None Include="..\..\third_party\wintun\LICENSE.txt"
          Link="wintun-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
