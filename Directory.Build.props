<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      CA2255: "ModuleInitializer is only for application code". Clash.Core
      deliberately uses module initializers so that each outbound protocol
      registers itself with AdapterRegistry when the assembly loads — that is the
      "advanced source generator" style the rule's own documentation carves out,
      and it is what keeps the core free of compile-time references to protocols.
    -->
    <NoWarn>$(NoWarn);CS1591;CA1416;NU1902;NU1903;CA2255</NoWarn>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''"></ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Clash.NET</Company>
    <Product>Clash for .NET</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

</Project>
